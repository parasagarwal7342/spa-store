# ---------- Required ----------
# Postgres connection string. On Vercel: Storage -> Create -> Neon (Postgres); it fills this in.
DATABASE_URL=postgres://user:password@host/db
# Long random string for signing logins. Generate: openssl rand -hex 32
AUTH_SECRET=
# Public site address (used in links, emails, sitemap).
NEXT_PUBLIC_SITE_URL=https://spaenterprise.in
# Owner account, created/updated by `npm run db:seed` and on first admin visit.
OWNER_EMAIL=
OWNER_PASSWORD=

# ---------- Payments ----------
# Razorpay -> Settings -> API Keys. Leave empty to offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay -> Settings -> Webhooks: URL https://spaenterprise.in/api/razorpay/webhook
# events: payment.captured, order.paid. Paste the same secret here.
RAZORPAY_WEBHOOK_SECRET=
COD_ENABLED=true

# ---------- Shipping (rupees) ----------
SHIPPING_FEE=500
FREE_SHIPPING_ABOVE=4999
# Delhi NCR pin codes (110, 121, 122, 201) always ship free.

# ---------- Optional ----------
# Slack/Discord incoming webhook: instant alert for each new order and enquiry.
NOTIFY_WEBHOOK_URL=
